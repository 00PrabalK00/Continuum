__pycache__/
*.py[cod]
.pytest_cache/
.venv/
dist/
build/
*.egg-info/
.continuum/
# Written by `continuum install`, and they name one machine's project path, so
# committing them would break the next clone. Narrowed to the generated files:
# anything else a contributor puts in these directories stays trackable.
.codex/config.toml
.gemini/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Output from unrelated local tooling
brag-output/
brag-output-*/

# Projects the benchmark generates as it runs
benchmarks/project/
benchmarks/conflict/
benchmarks/conflict2/
benchmarks/suite/
benchmarks/suite_postfix/
benchmarks/empty/
benchmarks/floor_codex/
